# ========================================================
# POLAR EXPLORER — Backend
# FastAPI + SQLAlchemy + Local StorageService
# Phase 3: Scientific Knowledge Repository
# ========================================================

# Application Settings
APP_NAME=POLAR EXPLORER
APP_ENV=development
DEBUG=true
SECRET_KEY=polar-explorer-dev-secret-key-change-in-production-abc123xyz
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database (SQLite for dev; swap to PostgreSQL in prod)
DATABASE_URL=sqlite:///./polar_explorer.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/polar_explorer

# Storage (local filesystem for dev)
STORAGE_BACKEND=local
STORAGE_BASE_PATH=./storage/uploads
STORAGE_BASE_URL=http://localhost:8000/api/repository/files

# File size limits (MB)
MAX_REPORT_SIZE_MB=50
MAX_DATASET_SIZE_MB=200
MAX_IMAGE_SIZE_MB=20
MAX_VIDEO_SIZE_MB=500
MAX_PUBLICATION_SIZE_MB=50
MAX_ACTIVITY_SIZE_MB=50

# MinIO (for future production use)
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=polar-explorer
# MINIO_SECURE=false

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
