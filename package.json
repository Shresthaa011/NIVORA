{
  "name": "polaris",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "backend": "python -m uvicorn backend.main:app --host 127.0.0.1 --port 8000 --reload",
    "start": "concurrently \"npm run backend\" \"npm run dev\"",
    "seed": "python backend/seed_data.py",
    "build": "tsc -b && vite build",
    "prod": "npm run build && python -m uvicorn backend.main:app --host 127.0.0.1 --port 8000",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@types/three": "^0.186.0",
    "lucide-react": "^1.52.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-globe.gl": "^2.38.0",
    "react-router-dom": "^7.18.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
